# Local Ollama server and the open-weight model to use.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Used when "Fast mode" is switched on in the UI.
OLLAMA_FAST_MODEL=gemma3:1b
# Context window in tokens. Lower it (e.g. 4096) if your laptop runs out of RAM.
OLLAMA_NUM_CTX=8192
# Seconds to wait for a response. CPU-only laptops can be slow.
OLLAMA_TIMEOUT=300

# Optional: enables live job search (https://serpapi.com/manage-api-key).
SERPAPI_KEY=
# Pages of results per search (~10 postings each, one search credit each). Results are cached for 6 hours.
JOB_SEARCH_PAGES=2
